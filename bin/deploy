#!/bin/sh
# Run ./bin/deploy from the project root. Optionally set HOST_PORT or BIND_ADDRESS.
set -eu
cd -- "$(dirname -- "$0")/.."

port=${HOST_PORT:-8113}
if ! { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } 2>/dev/null; then
  printf 'HOST_PORT 应为 1 到 65535 之间的端口号。\n' >&2
  exit 2
fi
bind_address=${BIND_ADDRESS:-0.0.0.0}
image=zhongkai-web:release
name=zhongkai-web-$port

docker build --tag "$image" \
  --build-arg VITE_SUPABASE_URL \
  --build-arg VITE_SUPABASE_PUBLISHABLE_KEY .

# Reserve the replacement name before touching the running site.
next_id=$(docker create --name "$name-next" --restart unless-stopped \
  --publish "$bind_address:$port:8113" "$image")
backup_id=
was_running=false
rollback() {
  docker stop "$next_id" >/dev/null || true
  if [ -n "$backup_id" ]; then
    docker rename "$backup_id" "$name"
    if [ "$was_running" = true ]; then docker start "$backup_id" >/dev/null; fi
  fi
  docker rm "$next_id" >/dev/null
}
trap rollback EXIT
trap 'exit 1' HUP INT TERM

old_id=$(docker container ls --all --quiet --filter "name=^/${name}$")
if [ -n "$old_id" ]; then
  if [ "$(docker inspect --format '{{.Config.Image}}' "$old_id")" != "$image" ]; then
    printf '容器名 %s 已被其他镜像占用，请检查容器或设置 HOST_PORT。\n' "$name" >&2
    exit 1
  fi
  was_running=$(docker inspect --format '{{.State.Running}}' "$old_id")
  docker rename "$old_id" "$name-old-$old_id"
  backup_id=$old_id
  if [ "$was_running" = true ]; then docker stop "$old_id" >/dev/null; fi
fi

docker start "$next_id" >/dev/null
attempt=1
until docker exec "$next_id" node -e '
  fetch("http://127.0.0.1:8113/", { signal: AbortSignal.timeout(2000) })
    .then(r => process.exit(r.status === 200 ? 0 : 1), () => process.exit(1))'
do
  if [ "$attempt" -ge 10 ]; then
    printf '首页健康检查失败，容器日志如下。\n' >&2
    docker logs --tail 20 "$next_id" >&2
    exit 1
  fi
  sleep 1
  attempt=$((attempt + 1))
done

docker rename "$next_id" "$name"
trap - EXIT HUP INT TERM
if [ -n "$backup_id" ]; then docker rm "$backup_id" >/dev/null; fi
printf '部署成功，容器 %s 已就绪，HTTP 端口 %s。\n' "$name" "$port"
