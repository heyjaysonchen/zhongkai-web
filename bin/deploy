#!/bin/sh
# Optional overrides: HTTPS_CERT_DIR, HOST_PORT, and BIND_ADDRESS.
set -eu
cd -- "$(dirname -- "$0")/.."

port=${HOST_PORT:-8113}
case "$port" in
  *[!0-9]*) port=0 ;;
esac
if ! { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } 2>/dev/null; then
  printf 'HOST_PORT 应为 1 到 65535 之间的端口号。\n' >&2
  exit 2
fi
export HOST_PORT="$port"

compose() {
  docker compose -f docker-compose.yml "$@"
}

compose config --quiet
compose build app nginx
compose run --rm --no-deps nginx nginx -t

# The previous deployment published this port from a standalone container.
legacy_name=zhongkai-web-$port
legacy_id=$(docker container ls --quiet --filter "name=^/${legacy_name}$")
legacy_stopped=false
restore_legacy() {
  if [ "$legacy_stopped" = true ]; then
    compose stop nginx app >&2 || true
    docker start "$legacy_id" >&2 || printf '旧容器 %s 恢复失败。\n' "$legacy_name" >&2
  fi
}
trap restore_legacy EXIT
trap 'exit 1' HUP INT TERM

if [ -n "$legacy_id" ]; then
  legacy_image=$(docker inspect --format '{{.Config.Image}}' "$legacy_id")
  if [ "$legacy_image" != 'zhongkai-web:release' ]; then
    printf '容器名 %s 已被镜像 %s 占用，请检查容器或设置 HOST_PORT。\n' "$legacy_name" "$legacy_image" >&2
    exit 1
  fi
  docker stop "$legacy_id" >/dev/null
  legacy_stopped=true
fi

if ! compose up -d --no-build --force-recreate --wait --wait-timeout 90; then
  compose logs --tail 30 >&2 || true
  exit 1
fi

trap - EXIT HUP INT TERM
printf '部署成功，应用直连端口 %s，Nginx HTTP 端口 80，HTTPS 端口 443。\n' "$port"
